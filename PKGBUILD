pkgname=murx
pkgver=0.20261116
pkgrel=1
pkgdesc='Small persistent terminal multiplexer'
arch=('x86_64' 'aarch64')
url='https://codeberg.org/armin/murx'
license=('Apache-2.0')
depends=('glibc')
source=('murx.c' 'Makefile' 'murx.1' 'README.md' 'LICENSE' 'AUTHORS')
sha256sums=('e88e3f143f861cc09bb3dec1fa9658d07ec1f88d74821d332452449aa747e36c'
            'c683ed74c664ebb2a72603297367ed102afdf27e4d6cee47920db8632a8efa91'
            'd7d36ecc3e8ab59cebfdcca317231e5eaae136d3097e7fe2ef8c2540886bf21a'
